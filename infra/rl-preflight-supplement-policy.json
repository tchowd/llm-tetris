{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectRLLaunchDependencies",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeImages",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets",
        "ec2:DescribeKeyPairs",
        "ec2:DescribeInstanceTypes"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {"aws:RequestedRegion": "us-east-1"}
      }
    },
    {
      "Sid": "ReadExistingTelemetryProfile",
      "Effect": "Allow",
      "Action": "iam:GetInstanceProfile",
      "Resource": "arn:aws:iam::566629888938:instance-profile/LLMTetrisTelemetryProfile"
    },
    {
      "Sid": "PassOnlyExistingTelemetryRoleToEC2",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::566629888938:role/LLMTetrisTelemetryRole",
      "Condition": {
        "StringEquals": {"iam:PassedToService": "ec2.amazonaws.com"}
      }
    },
    {
      "Sid": "VerifyProjectBudgetAlertDelivery",
      "Effect": "Allow",
      "Action": ["sns:ListSubscriptionsByTopic", "sns:GetTopicAttributes"],
      "Resource": "arn:aws:sns:us-east-1:566629888938:llm-tetris-budget-alerts"
    },
    {
      "Sid": "ReadCurrentComputePrices",
      "Effect": "Allow",
      "Action": "pricing:GetProducts",
      "Resource": "*"
    }
  ]
}
