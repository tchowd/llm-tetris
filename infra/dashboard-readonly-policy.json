{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProjectInventoryAndTelemetry",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceStatus",
        "ec2:DescribeVolumes",
        "ec2:DescribeTags",
        "cloudwatch:GetMetricData",
        "cloudwatch:ListMetrics",
        "cloudwatch:DescribeAlarms",
        "logs:DescribeLogGroups",
        "logs:DescribeLogStreams",
        "logs:FilterLogEvents",
        "logs:GetLogEvents",
        "tag:GetResources",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CostCreditsAndQuotas",
      "Effect": "Allow",
      "Action": [
        "ce:GetCostAndUsage",
        "ce:GetCostForecast",
        "billing:GetCredits",
        "servicequotas:GetServiceQuota",
        "servicequotas:ListRequestedServiceQuotaChangeHistoryByQuota",
        "budgets:ViewBudget"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadConfiguredPrincipalPosture",
      "Effect": "Allow",
      "Action": [
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:GetUser",
        "iam:ListAttachedUserPolicies",
        "iam:ListUserPolicies",
        "iam:GetUserPolicy"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadProjectArtifacts",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::llm-tetris-artifacts-566629888938-us-east-1",
      "Condition": {
        "StringLike": {
          "s3:prefix": "runs/*"
        }
      }
    },
    {
      "Sid": "DownloadProjectArtifacts",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::llm-tetris-artifacts-566629888938-us-east-1/runs/*"
    }
  ]
}
