{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LaunchOnlyStage6Scale10xL40S",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:us-east-1:566629888938:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "ec2:InstanceType": "g6e.2xlarge",
          "ec2:MetadataHttpTokens": "required",
          "aws:RequestTag/Project": "llm-tetris",
          "aws:RequestTag/Stage": "6",
          "aws:RequestTag/RunId": "rl-scale10x-seed0"
        },
        "ArnEquals": {
          "ec2:InstanceProfile": "arn:aws:iam::566629888938:instance-profile/LLMTetrisTelemetryProfile"
        }
      }
    }
  ]
}
