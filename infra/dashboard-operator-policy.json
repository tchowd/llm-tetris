{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OperateTaggedTrainingInstances",
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:RebootInstances"
      ],
      "Resource": "arn:aws:ec2:us-east-1:566629888938:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Project": "llm-tetris"
        }
      }
    },
    {
      "Sid": "MaintainProjectTags",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:566629888938:instance/*",
        "arn:aws:ec2:us-east-1:566629888938:volume/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Project": "llm-tetris"
        }
      }
    },
    {
      "Sid": "ManageProjectLogRetention",
      "Effect": "Allow",
      "Action": "logs:PutRetentionPolicy",
      "Resource": "arn:aws:logs:us-east-1:566629888938:log-group:/llm-tetris/jobs:*"
    },
    {
      "Sid": "ManageProjectAlarms",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:DeleteAlarms"
      ],
      "Resource": "arn:aws:cloudwatch:us-east-1:566629888938:alarm:llm-tetris-*"
    },
    {
      "Sid": "PublishProjectArtifacts",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::llm-tetris-artifacts-566629888938-us-east-1",
      "Condition": {
        "StringLike": {
          "s3:prefix": "runs/*"
        }
      }
    },
    {
      "Sid": "WriteProjectArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:AbortMultipartUpload",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::llm-tetris-artifacts-566629888938-us-east-1/runs/*"
    }
  ]
}
