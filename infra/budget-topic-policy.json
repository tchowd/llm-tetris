{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowAccountAdministration",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::566629888938:root"
      },
      "Action": [
        "SNS:GetTopicAttributes",
        "SNS:SetTopicAttributes",
        "SNS:AddPermission",
        "SNS:RemovePermission",
        "SNS:DeleteTopic",
        "SNS:Subscribe",
        "SNS:ListSubscriptionsByTopic",
        "SNS:Publish"
      ],
      "Resource": "arn:aws:sns:us-east-1:566629888938:llm-tetris-budget-alerts"
    },
    {
      "Sid": "AllowBudgetsToPublish",
      "Effect": "Allow",
      "Principal": {
        "Service": "budgets.amazonaws.com"
      },
      "Action": "SNS:Publish",
      "Resource": "arn:aws:sns:us-east-1:566629888938:llm-tetris-budget-alerts",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "566629888938"
        }
      }
    }
  ]
}
