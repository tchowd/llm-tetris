{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Bounded Stage 6 LLM Tetris RL worker with encrypted, delete-on-termination root storage and IMDSv2.",
  "Parameters": {
    "ImageId": {
      "Type": "AWS::EC2::Image::Id"
    },
    "SubnetId": {
      "Type": "AWS::EC2::Subnet::Id"
    },
    "SecurityGroupId": {
      "Type": "AWS::EC2::SecurityGroup::Id"
    },
    "KeyName": {
      "Type": "AWS::EC2::KeyPair::KeyName"
    },
    "InstanceProfileName": {
      "Type": "String",
      "Description": "Instance profile with only telemetry and encrypted artifact-bucket access."
    },
    "InstanceType": {
      "Type": "String",
      "Default": "g5.xlarge",
      "AllowedValues": ["g5.xlarge", "g5.2xlarge"]
    },
    "RootVolumeGiB": {
      "Type": "Number",
      "Default": 100,
      "MinValue": 50,
      "MaxValue": 500
    },
    "RunId": {
      "Type": "String"
    },
    "PilotDollarLimit": {
      "Type": "Number",
      "Default": 20
    }
  },
  "Resources": {
    "Worker": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": {"Ref": "ImageId"},
        "InstanceType": {"Ref": "InstanceType"},
        "SubnetId": {"Ref": "SubnetId"},
        "SecurityGroupIds": [{"Ref": "SecurityGroupId"}],
        "KeyName": {"Ref": "KeyName"},
        "IamInstanceProfile": {"Ref": "InstanceProfileName"},
        "PropagateTagsToVolumeOnCreation": true,
        "MetadataOptions": {
          "HttpEndpoint": "enabled",
          "HttpTokens": "required",
          "HttpPutResponseHopLimit": 1
        },
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/sda1",
            "Ebs": {
              "DeleteOnTermination": true,
              "Encrypted": true,
              "VolumeSize": {"Ref": "RootVolumeGiB"},
              "VolumeType": "gp3"
            }
          }
        ],
        "Tags": [
          {"Key": "Name", "Value": {"Fn::Sub": "llm-tetris-rl-${RunId}"}},
          {"Key": "Project", "Value": "llm-tetris"},
          {"Key": "Stage", "Value": "6"},
          {"Key": "RunId", "Value": {"Ref": "RunId"}},
          {"Key": "PilotDollarLimit", "Value": {"Ref": "PilotDollarLimit"}}
        ]
      },
      "DeletionPolicy": "Delete"
    }
  },
  "Outputs": {
    "InstanceId": {
      "Value": {"Ref": "Worker"}
    },
    "PublicIp": {
      "Value": {"Fn::GetAtt": ["Worker", "PublicIp"]}
    }
  }
}
